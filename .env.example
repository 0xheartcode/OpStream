# OpStream — environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── OPNET RPC ──────────────────────────────────────────────────────────────────
OPNET_RPC_URL=https://mainnet.opnet.org

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=data/opstream.db

# ── Bootstrap scanner ─────────────────────────────────────────────────────────
BOOTSTRAP_FROM_BLOCK=941400       # Starting block (ignored if checkpoint exists)
BOOTSTRAP_RPS=10                  # RPC rate limit (requests per second)
BOOTSTRAP_CHUNK_SIZE=500          # Blocks per batch

# ── Live indexer ──────────────────────────────────────────────────────────────
# (no extra vars — uses RPS from bootstrap)

# ── Real-time event push ───────────────────────────────────────────────────────
WS_PORT=0                         # WebSocket broadcast port (0 = disabled)
WEBHOOK_URLS=                     # Comma-separated HTTP callback URLs

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=human                  # human | json

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_INTERVAL_SECONDS=60
