# OpStream — environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── OPNET RPC ──────────────────────────────────────────────────────────────────
OPNET_RPC_URL=https://mainnet.opnet.org

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default — leave DB_URL unset):
DB_PATH=data/opstream.db

# Postgres (set DB_URL to override — DB_PATH is ignored when DB_URL is set):
# DB_URL=postgres://opstream:secret@localhost:5432/opstream

# ── Bootstrap scanner ─────────────────────────────────────────────────────────
BOOTSTRAP_FROM_BLOCK=941400       # Starting block (ignored if checkpoint exists)
BOOTSTRAP_RPS=10                  # RPC rate limit (requests per second)
BOOTSTRAP_CHUNK_SIZE=500          # Blocks per batch

# ── Run mode ──────────────────────────────────────────────────────────────────
# OPSTREAM_MODE=indexer             # indexer (default) | mempool | full (both)

# ── Bitcoin RPC (required for mempool/full mode) ─────────────────────────────
# BITCOIN_RPC_URL=http://user:pass@localhost:8332
# BITCOIN_RPC_USER=rpcuser
# BITCOIN_RPC_PASS=rpcpassword

# ── Mempool poller ───────────────────────────────────────────────────────────
# MEMPOOL_POLL_INTERVAL_MS=10000    # Poll interval in ms (default 10s)

# ── Real-time event push ───────────────────────────────────────────────────────
WS_PORT=0                         # WebSocket broadcast port (0 = disabled)
WEBHOOK_URLS=                     # Comma-separated HTTP callback URLs

# ── Fast sync ─────────────────────────────────────────────────────────────────
# SYNC_SOURCE_URL is the remote OpStream instance to pull data from.
# Run `npx tsx src/main.ts sync` to import its data into your local DB.
# The sync command uses 100-block chunks of gzip-compressed NDJSON — orders of
# magnitude faster than bootstrapping block-by-block from the OPNET RPC.
#
# Mainnet (Railway):
SYNC_SOURCE_URL=https://opstream-mainnet-production.up.railway.app
#
# Testnet (Railway):
# SYNC_SOURCE_URL=https://opstream-testnet-production.up.railway.app
#
# SYNC_SECRET: shared secret for /sync/* auth.
# Set the same value on both the server (the remote OpStream) and the client (.env here).
# Leave unset (or empty) to open the sync endpoints without auth.
# SYNC_SECRET=
# SYNC_CONCURRENCY=8         # parallel chunk fetches (default 8, raise on fast connections)

# ── Postgres (only when using --profile postgres in docker-compose) ───────────
POSTGRES_PASSWORD=opstream_secret

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                    # DEBUG | INFO | WARN | ERROR
LOG_FORMAT=human                  # human | json

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_INTERVAL_SECONDS=60
